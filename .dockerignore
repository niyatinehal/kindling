# Keep the build context small and prevent host artifacts leaking into the image.
#
# Docker matches these patterns against the whole context-relative path and,
# unlike .gitignore, a slashless pattern does NOT match at every depth. Since
# the backend moved into api/, bare `node_modules/`, `dist/` and `.env` match
# nothing that matters — hence the `**/` prefixes below.
**/node_modules/
**/dist/
coverage/
.git/
.github/

# Never bake real secrets into an image layer. The backend's .env lives at
# api/.env since the workspace move, and the builder's `COPY api ./api` would
# otherwise pull it — and SUPABASE_SERVICE_ROLE_KEY with it — into a cached
# layer. The negation keeps the root .env.example template in the context.
**/.env
**/.env.*
!.env.example

# Not needed to build or run the compiled app.
api/test/
api/jest.config.js
api/eslint.config.js
.prettierrc
.prettierignore
Dockerfile
.dockerignore
docker-compose.yml
README.md
**/*.log
**/*.tsbuildinfo

api/generated/

# The frontend workspace arrives in slice 1; it is never part of the backend
# image's build context.
web/
