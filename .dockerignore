# Keep the build context small and prevent host artifacts leaking into the image.
node_modules/
dist/
coverage/
.git/
.github/

# Never bake real secrets into an image layer.
.env
.env.*
!.env.example

# Not needed to build or run the compiled app.
test/
jest.config.js
eslint.config.js
.prettierrc
.prettierignore
Dockerfile
.dockerignore
docker-compose.yml
README.md
*.log
*.tsbuildinfo

generated/
