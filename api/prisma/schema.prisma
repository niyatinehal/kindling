generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // Required: without this the client imports "./enums.ts" and tsc fails
  // under module: "nodenext".
  importFileExtension    = "js"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  hi
}

enum UserStatus {
  active
  suspended
  deleted
}

enum FamilyRole {
  admin
  adult
  child
  elderly
}

enum MembershipStatus {
  active
  left
  removed
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Supabase auth.users.id. Every user now originates from Supabase Auth, so
  /// this link is mandatory; the foreign key is added by a hand-written
  /// migration because the auth schema is deliberately not modelled here.
  authUserId String @unique @map("auth_user_id") @db.Uuid

  email       String?    @map("email")
  phone       String?    @map("phone")
  displayName String     @map("display_name")
  locale      Locale     @default(en)
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile         Profile?
  workoutPlans    WorkoutPlan[]
  trackingLogs    TrackingLog[]
  createdFamilies Family[]           @relation("FamilyCreatedBy")
  memberships     FamilyMembership[]
  createdInvites  FamilyInvite[]     @relation("InviteCreatedBy")
  acceptedInvites FamilyInvite[]     @relation("InviteAcceptedBy")
  consents        ConsentRecord[]    @relation("UserConsents")
  grantedConsents ConsentRecord[]    @relation("ConsentGrantedBy")
  llmCalls        LlmCall[]

  @@map("users")
}

model Family {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("FamilyCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships FamilyMembership[]
  invites     FamilyInvite[]

  @@map("families")
}

model FamilyMembership {
  id String @id @default(uuid(7)) @db.Uuid

  familyId String @map("family_id") @db.Uuid
  family   Family @relation(fields: [familyId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  role     FamilyRole
  status   MembershipStatus @default(active)
  joinedAt DateTime         @map("joined_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  visibilitySettings VisibilitySetting[]

  @@unique([familyId, userId])
  @@index([familyId, role])
  @@map("family_memberships")
}

enum Sex {
  male
  female
  other
  prefer_not_to_say
}

enum FitnessGoal {
  fat_loss
  muscle_gain
  general_fitness
  mobility
  endurance
  strength
}

enum FitnessLevel {
  beginner
  intermediate
  advanced
}

enum SpaceCategory {
  small_room
  large_room
  outdoor
  gym
}

enum Equipment {
  none
  resistance_band
  dumbbells
  kettlebell
  pull_up_bar
  yoga_mat
  jump_rope
  bench
  treadmill
  stationary_bike
  full_gym
}

/// Body region, not a diagnosis. Overlaps MedicalCondition on purpose: a knee
/// arthritis sufferer declares both, and each is a key into the workout
/// contraindication table. Neither is authoritative alone.
enum Injury {
  knee
  lower_back
  shoulder
  neck
  wrist
  ankle
  hip
}

enum MedicalCondition {
  type_2_diabetes
  hypertension
  heart_condition
  asthma
  arthritis
  osteoporosis
  pregnancy
  thyroid_disorder
}

enum DietaryConstraint {
  vegetarian
  non_vegetarian
  eggetarian
  jain
  vegan
  no_dairy
  no_gluten
  no_nuts
}

/// The wellness profile behind every generated plan (PRD FR-PROF-1).
///
/// Separate from `User` rather than columns on it: `User` is the identity
/// record, and keeping the wellness answers in one object gives the workout
/// slice a single thing to snapshot onto a plan.
///
/// There is deliberately NO partial state. Every column a plan depends on is
/// required, and the API rejects an empty `equipment` array, so "a row exists"
/// is the whole completeness predicate — no draft rows, no half-answered
/// profiles to defend against downstream.
model Profile {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// The birth YEAR, not an age. A stored age is wrong within a year and drifts
  /// silently, and age feeds both the elderly track and the safety rules.
  birthYear Int      @map("birth_year")
  sex       Sex?
  heightCm  Int?     @map("height_cm")
  weightKg  Decimal? @map("weight_kg") @db.Decimal(5, 2)

  goal  FitnessGoal
  level FitnessLevel
  space SpaceCategory

  equipment  Equipment[]
  injuries   Injury[]
  conditions MedicalCondition[]
  dietary    DietaryConstraint[]

  /// Free text the user adds in their own words. Passed to the LLM as context;
  /// it must never drive a hard exclusion, because prose is not a stable key.
  notes String?

  /// Opt-in to having typed pantry text read by an outside AI service. Off by
  /// default, and never consulted for a child account, which uses the synonym
  /// table whatever this says. Only the pantry text is ever sent — nothing on
  /// this row reaches the provider.
  aiPantryConsent   Boolean   @default(false) @map("ai_pantry_consent")
  /// When consent was given. Cleared on withdrawal, so it is null whenever the
  /// flag is false.
  aiPantryConsentAt DateTime? @map("ai_pantry_consent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

enum PlanStatus {
  active
  superseded
}

/// A generated workout plan (PRD FR-WRK-1).
///
/// `profileSnapshot` is the whole profile as it stood when the plan was built,
/// which is what PRD §14 means by a plan being "tied to a Profile snapshot": the
/// plan stays explainable after the profile moves on, and comparing the snapshot
/// against the live profile is how the regeneration prompt in FR-PROF-2 knows
/// something changed. It is a JSON copy rather than a foreign key to a version
/// table because nothing else needs profile history.
model WorkoutPlan {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  status PlanStatus @default(active)

  /// Which generator produced this, e.g. `rules@1`. Recorded so a plan built by
  /// the deterministic engine stays distinguishable from one built by a future
  /// LLM adapter — without it, an output-quality regression has no provenance.
  generator String

  profileSnapshot Json @map("profile_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exercises PlanExercise[]

  @@index([userId, status])
  @@map("workout_plans")
}

/// One exercise on one day of a plan (PRD §14's `Exercise`).
///
/// `exerciseKey` points into the code-owned exercise library rather than a
/// catalog table: the library is reference data that ships with the code and is
/// what the contraindication rules are written against, so keeping it in git
/// makes both reviewable in one diff.
model PlanExercise {
  id String @id @default(uuid(7)) @db.Uuid

  planId String      @map("plan_id") @db.Uuid
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 1 = Monday through 7 = Sunday, matching ISO-8601.
  dayOfWeek Int @map("day_of_week")
  position  Int

  exerciseKey String @map("exercise_key")

  sets            Int?
  /// Null for a held or timed movement, where `durationSeconds` carries the dose.
  reps            Int?
  durationSeconds Int? @map("duration_seconds")
  restSeconds     Int  @map("rest_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  trackingLogs TrackingLog[]

  @@unique([planId, dayOfWeek, position])
  @@index([planId, dayOfWeek])
  @@map("plan_exercises")
}

/// The roles an invite may confer. Deliberately NOT `FamilyRole`: the design doc
/// requires that `admin` never be invite-assignable, and a separate enum makes
/// privilege escalation by invite unrepresentable rather than merely validated.
/// Promotion to admin goes through the role-change route, which is itself
/// admin-guarded.
enum InvitableRole {
  adult
  child
  elderly
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

model FamilyInvite {
  id String @id @default(uuid(7)) @db.Uuid

  familyId String @map("family_id") @db.Uuid
  family   Family @relation(fields: [familyId], references: [id])

  invitedRole InvitableRole @map("invited_role")

  /// Generated from `crypto.randomBytes`, never `Math.random` — a guessable code
  /// is a way into someone's family health data.
  inviteCode String @unique @map("invite_code")

  /// Who it was meant for, when the admin knew. Free text: an invite may be read
  /// out loud rather than sent.
  invitedContact String? @map("invited_contact")

  status    InviteStatus @default(pending)
  expiresAt DateTime     @map("expires_at")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])

  acceptedByUserId String? @map("accepted_by_user_id") @db.Uuid
  acceptedBy       User?   @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([familyId, status])
  @@map("family_invites")
}

/// The categories a member can share or withhold (PRD FR-AUTH-5).
enum DataCategory {
  adherence_summary
  weight
  workout_detail
  meal_detail
  sleep
  water
  medical_conditions
}

enum Visibility {
  visible
  hidden
}

/// Per-member, per-category sharing rule.
///
/// Rows are created EAGERLY — one per category — in the same transaction as the
/// membership, on both family creation and invite acceptance. A membership with
/// no rows would leave a dashboard query undefined, and the design doc is
/// explicit that there is no implicit fallback read at query time.
///
/// Defaults are asymmetric on purpose: `adherence_summary` starts `visible` so an
/// admin dashboard has something to show, everything genuinely sensitive starts
/// `hidden` so sharing is opt-in. `isLockedBySafetyFloor` constrains WRITES only
/// — it means "this member may not hide this on their own", and never "an admin
/// may read it anyway".
model VisibilitySetting {
  id String @id @default(uuid(7)) @db.Uuid

  membershipId String           @map("membership_id") @db.Uuid
  membership   FamilyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  dataCategory DataCategory @map("data_category")
  visibility   Visibility

  isLockedBySafetyFloor Boolean @default(false) @map("is_locked_by_safety_floor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([membershipId, dataCategory])
  @@map("visibility_settings")
}

/// What a log entry is about (PRD FR-TRK-3's four categories).
///
/// `steps` is deliberately absent. There is no Web API for step count, no
/// background sensor access in a PWA, and PRD §5's MVP logging list does not
/// include it — steps arrive with wearable sync in v2, if at all.
enum TrackingType {
  workout
  meal
  water
  sleep
}

enum TrackingStatus {
  completed
  skipped
  logged
}

/// One tracking entry (PRD §14's `TrackingLog`).
///
/// Deliberately one generic table rather than four typed ones: every consumer —
/// the tiles, the adherence rollup, the future family dashboard — wants "this
/// member's entries for this period" across categories, and four tables would
/// make that a union in every query. `value` and `rating` carry different units
/// per type, which is documented per field and enforced in the request schema.
model TrackingLog {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  type   TrackingType
  status TrackingStatus

  /// The DAY this counts toward, not the instant it was recorded. A workout
  /// finished at 11pm belongs to that day, and sleep logged on waking belongs to
  /// the night before — so the caller says which day it is for.
  loggedFor DateTime @map("logged_for") @db.Date

  /// water: millilitres. sleep: minutes. workout and meal: null — completion is
  /// carried by `status`, and a made-up number would be fiction.
  value Int?

  /// Which scheduled exercise this completes. Present only on workout logs, and
  /// what makes adherence "completed ÷ scheduled" rather than a guess.
  planExerciseId String?       @map("plan_exercise_id") @db.Uuid
  planExercise   PlanExercise? @relation(fields: [planExerciseId], references: [id], onDelete: SetNull)

  /// 1–5. Perceived difficulty on a workout (FR-TRK-1), sleep quality on sleep
  /// (FR-TRK-2). Optional on both.
  rating Int?

  /// Which library dish this meal was, when it was one. Null means the user
  /// typed their own — FR-TRK-2 logs meals "from suggested plan or freeform", and
  /// the two need telling apart: a key gets translated for display, prose is
  /// shown verbatim. Conflating them into `notes` made "poha" ambiguous between
  /// a recipe and something someone wrote.
  recipeKey String? @map("recipe_key")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One entry per scheduled exercise per day: a double-tapped "done" must not
  /// count twice, and the service upserts on this.
  @@unique([userId, planExerciseId, loggedFor])
  @@index([userId, type, loggedFor])
  @@map("tracking_logs")
}

enum ConsentType {
  health_data
  minor_guardian
  marketing_notifications
  photo_retention
}

model ConsentRecord {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserConsents", fields: [userId], references: [id])

  consentType ConsentType @map("consent_type")

  /// Self, or an Admin consenting on behalf of a minor (PRD §17).
  grantedByUserId String @map("granted_by_user_id") @db.Uuid
  grantedBy       User   @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id])

  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  /// Which consent copy was shown. Required so an audit can reproduce it.
  policyVersion String @map("policy_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, consentType])
  @@map("consent_records")
}

/// Something that went wrong, kept so it can be looked at later.
///
/// Deliberately carries NO user id and no foreign key to `users`. Two reasons,
/// and both matter. Every other reference into `users` is ON DELETE RESTRICT,
/// so error rows pointing at somebody would block the account deletion flow —
/// the person could not leave because of a log line about them. And an erasure
/// promise that leaves their id behind in a table nothing prunes is not
/// erasure. A request id is enough to tie an error to a request without tying
/// it to a person.
///
/// `message` and `stack` are redacted on the way in (src/observability/redact.ts),
/// which is what keeps these rows non-personal rather than merely
/// user-id-free.
model ErrorEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Correlates with the x-request-id header echoed back to the caller, so a
  /// person reporting "it broke" can be matched to the row without being
  /// identified by it.
  requestId String? @map("request_id")

  method String?
  path   String?
  status Int

  name    String
  message String
  stack   String?

  @@index([occurredAt])
  @@map("error_events")
}

/// A shared cache of model answers to pantry text, so a pantry somebody has
/// already typed costs nothing the second time.
///
/// Holds no user data and no raw text: the key is a SHA-256 of the normalised
/// text plus the prompt version, and the value is only ingredient keys and the
/// short phrases the model could not map. That is why it is shared across
/// users rather than keyed to one, and why it has no user id to delete by.
model PantryParseCache {
  textHash      String   @id @map("text_hash")
  promptVersion String   @map("prompt_version")
  recognised    String[]
  unrecognised  String[]
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("pantry_parse_cache")
}

enum LlmCallOutcome {
  ok
  timeout
  provider_error
  invalid_output
  cache_hit
  breaker_open
  rate_limited
}

/// One row per model attempt, and per parse that skipped the model on purpose
/// (a cache hit, an open breaker, the daily limit). It is what the daily limit
/// counts and what latency, cost and failure rates are reported from.
///
/// Numbers and outcomes only — never the text that was sent. Cascades with the
/// user: these are operational records about a person's use, and an erased
/// account takes them with it.
model LlmCall {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       String
  model         String
  promptVersion String         @map("prompt_version")
  outcome       LlmCallOutcome
  inputTokens   Int?           @map("input_tokens")
  outputTokens  Int?           @map("output_tokens")
  latencyMs     Int            @map("latency_ms")
  /// Millionths of a US dollar, as an integer for the reason money is never a float.
  costMicroUsd  Int?           @map("cost_micro_usd")
  requestId     String         @map("request_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("llm_calls")
}

/// One sentence on why a suggested dish suits a kitchen, as the model wrote it
/// and as `checkExplanation` let it through. Keyed by a hash of the prompt
/// version, the recipe and which of its ingredients are on hand — nothing
/// about who asked — so it is shared across users like the parse cache.
model DishExplanationCache {
  cacheKey  String   @id @map("cache_key")
  generator String
  recipeKey String   @map("recipe_key")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("dish_explanation_cache")
}
