# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored and must never be committed. This file holds no real values.

# ---- App ----
# Port the Node process listens on. Defaults to 3000 if unset.
PORT=3000

# Host port that docker compose maps to the container's 3000.
APP_PORT=3000

# ---- Postgres ----
# Pooled connection — used by the app at runtime.
# Local: the Supabase CLI stack has no pooler, so this matches DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct connection — used by the Prisma CLI for migrations only.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
