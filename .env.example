# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored and must never be committed. This file holds no real values.

# ---- App ----
# Port the Node process listens on. Defaults to 3000 if unset.
PORT=3000

# Host port that docker compose maps to the container's 3000.
APP_PORT=3000

# ---- Postgres ----
# Pooled connection — used by the app at runtime.
# Local: the Supabase CLI stack has no pooler, so this matches DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct connection — used by the Prisma CLI for migrations only.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Used only by `prisma migrate diff` (the CI drift check that fails a
# build when schema.prisma was edited without a matching migration) — see
# prisma.config.ts, which reads this as datasource.shadowDatabaseUrl. Prisma 7
# removed the `--shadow-database-url` CLI flag, so this env var is the only way
# to set it. Must point at a separate, always-empty database: the schema
# engine replays every migration onto it from scratch, destroying anything
# already there. Leave unset to skip the drift check locally; CI sets its own.
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/shadow

# ---- AI pantry parsing (optional) ----
# Off unless LLM_ENABLED is true AND LLM_API_KEY is set; off, free-text pantry
# input is read by the built-in synonym table and nothing leaves the server.
# Users must still opt in from the meals screen, and child accounts never use
# it. Turning this on in production also needs the privacy page and README
# updated to name the provider — they currently promise nothing is sent out.
# LLM_ENABLED=false
# LLM_API_KEY=

# ---- Supabase ----
# Base URL of the Supabase project. The JWT issuer is <SUPABASE_URL>/auth/v1 and
# the JWKS endpoint is <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# No trailing slash. Locally this is what `npx supabase status` prints as API_URL.
SUPABASE_URL=http://127.0.0.1:54321

# Service-role key, used ONLY by `prisma db seed` to create auth users.
# The request path never reads it. Locally, copy SERVICE_ROLE_KEY from
# `npx supabase status`. Never commit a real value and never send it to a client.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Email delivery (optional) ----
# With SMTP_HOST unset, every sign-in code goes to the Supabase stack's bundled
# Mailpit inbox at http://127.0.0.1:54324 and nothing leaves the machine. That is
# the right default for development: a local stack wired to a real relay emails
# real people every time anyone tests a sign-in, and spends the daily quota to do
# it.
#
# To send real mail, all three steps are required — filling these in alone does
# nothing, and flipping the config alone breaks sending outright:
#   1. set the variables below
#   2. set enabled = true in [auth.email.smtp] in supabase/config.toml
#   3. npx supabase stop && npx supabase start
# The CLI reads both this file and config.toml only at startup, so nothing short
# of a restart picks up either change.
# The port is fixed at 587 in supabase/config.toml (that field is typed as an
# integer, so it cannot be an env var, and 587 is universal anyway).
#
# Pick a provider by whether you have a domain:
#   - No domain: Brevo. Verify one sender address (a personal Gmail is fine) and
#     you can mail anyone, 300/day free. SMTP_HOST=smtp-relay.brevo.com, and
#     SMTP_USER is the login shown on its SMTP page, not your email.
#   - Own a domain: Resend or Postmark give better deliverability. Note Resend's
#     free tier will only deliver to your own account address until a domain is
#     verified, which makes it useless for testing with family.
# Either way, verify the sender and add the provider's SPF/DKIM records, or a
# six-digit code from a brand-new sender lands in spam.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# The From: address. Providers reject mail from an address they have not
# verified, so this must be one you completed verification for.
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME=Family Wellness

# ---- Web (frontend workspace) ----
# The browser needs these two to reach Supabase for the OAuth redirect only;
# every authentication call itself runs server-side.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `npx supabase status` prints this as ANON_KEY. It is a public key by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the Express API listens. Only this app's route handlers call it.
API_BASE_URL=http://127.0.0.1:3000

# Shared secret the web app presents when reporting a failure it handled
# itself — a sign-in email refused because the daily quota ran out, say. Those
# never reach the API's error handler, because they never reach the API, so
# without this they are invisible: the user is told to check an address that
# was fine and nobody learns the real reason.
#
# Optional, and both ends agree by default. Unset, the API does not mount the
# receiving route and the web app does not call it, so nothing breaks and no
# open write endpoint exists. Set it on BOTH Render and Vercel, to the same
# value. Any long random string: `openssl rand -hex 32`.
# INTERNAL_REPORT_TOKEN=
