# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored and must never be committed. This file holds no real values.

# ---- App ----
# Port the Node process listens on. Defaults to 3000 if unset.
PORT=3000

# Host port that docker compose maps to the container's 3000.
APP_PORT=3000

# ---- Postgres ----
# Not used by any code in Sprint 0 — the container is stood up so the topology
# is already correct when Sprint 1 starts connecting to it.
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness
POSTGRES_DB=wellness
POSTGRES_PORT=5432

# Connection string for running the app on the host against the compose
# Postgres. Inside compose, the app gets host `db` instead of `localhost`.
DATABASE_URL=postgres://wellness:wellness@localhost:5432/wellness
